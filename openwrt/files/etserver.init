#!/bin/sh /etc/rc.common
# Init script for Eternal Terminal (etserver) on OpenWrt

START=90
STOP=10

USE_PROCD=1
PROG=/usr/bin/etserver

start_service() {
    # Ensure /var/run/etserver exists with secure permissions
    mkdir -p /var/run/etserver
    chmod 0700 /var/run/etserver

    procd_open_instance
    procd_set_param command $PROG
    procd_set_param env XDG_RUNTIME_DIR="/var/run"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

reload_service() {
    stop_service
    start_service
}
