# Isolated Ghostty config for HTM GUI e2e. Loaded with
# --config-default-files=false so ~/.config/ghostty is ignored.
confirm-close-surface = false
quit-after-last-window-closed = true
window-save-state = never
auto-update = off
desktop-notifications = false

# Match the iTerm2 / WezTerm e2e keybinds so Cmd+D/T/W drive splits and tabs.
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+t=new_tab
keybind = super+n=new_window
keybind = super+w=close_surface
keybind = super+[=goto_split:previous
keybind = super+]=goto_split:next
keybind = super+shift+[=previous_tab
keybind = super+shift+]=next_tab
# Gateway is always tab 1 while control mode is active.
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9
# Needed because --config-default-files=false drops the OS defaults.
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard
keybind = super+a=select_all
