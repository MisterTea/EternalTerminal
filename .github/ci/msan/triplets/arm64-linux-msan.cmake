set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../toolchain.cmake")
set(VCPKG_ENV_PASSTHROUGH MSAN_LIBCXX_ROOT)
set(VCPKG_C_FLAGS "-fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer -fPIC")
set(VCPKG_CXX_FLAGS "${VCPKG_C_FLAGS} -stdlib=libc++ -nostdinc++ -isystem $ENV{MSAN_LIBCXX_ROOT}/include/c++/v1")
set(VCPKG_LINKER_FLAGS "-fsanitize=memory -L$ENV{MSAN_LIBCXX_ROOT}/lib")
