#!/usr/bin/make -f
export DH_VERBOSE = 1
# Debug symbols are larger than the PPA quota can hold.
export DEB_BUILD_OPTIONS += noautodbgsym

%:
	dh $@ --parallel --with systemd --buildsystem=cmake --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- -DDISABLE_VCPKG:BOOL=ON

override_dh_install:
	dh_install
	mkdir -p debian/et/etc
	cp ./etc/et.cfg debian/et/etc/

override_dh_auto_test:
	: # Disable ctest on debian because of odd errors on ubuntu 18.04

override_dh_strip:
	dh_strip --no-automatic-dbgsym
